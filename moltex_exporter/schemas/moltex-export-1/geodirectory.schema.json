{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moltex.dev/schemas/moltex-export-1/geodirectory.schema.json",
  "title": "Moltex GeoDirectory evidence",
  "type": "object",
  "required": ["schema_version", "post_types", "privacy"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "post_types": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["detail_storage", "fields", "search_fields", "sort_fields", "tabs"],
        "properties": {
          "detail_storage": {"type": "string"},
          "fields": {"type": "array"},
          "search_fields": {"type": "array"},
          "sort_fields": {"type": "array"},
          "tabs": {"type": "array"},
          "all_fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "disposition", "is_active", "definition"],
              "properties": {
                "key": {"type": "string"},
                "label": {"type": "string"},
                "disposition": {"type": "string", "pattern": "^(exported|inactive|admin_only|operator_included|sensitive:[a-z_]+)$"},
                "is_active": {"type": "boolean"},
                "publicly_displayed": {"type": "boolean"},
                "definition": {"type": "object"}
              }
            }
          },
          "unkeyed_rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "disposition", "definition"],
              "properties": {
                "id": {"type": "integer"},
                "disposition": {"const": "no_htmlvar_name"},
                "definition": {"type": "object"}
              }
            }
          },
          "field_summary": {
            "type": "object",
            "properties": {
              "source_rows": {"type": "integer", "minimum": 0},
              "by_disposition": {"type": "object", "additionalProperties": {"type": "integer"}}
            }
          }
        }
      }
    },
    "field_reconciliation": {
      "type": "object",
      "required": ["source_rows", "by_post_type", "rows_outside_export"],
      "properties": {
        "source_rows": {"type": "integer", "minimum": 0},
        "by_post_type": {"type": "object", "additionalProperties": {"type": "integer"}},
        "rows_outside_export": {"type": "array", "items": {"type": "object", "required": ["id", "post_type", "reason"]}}
      }
    },
    "privacy": {
      "type": "object",
      "required": ["excluded_field_keys"],
      "properties": {
        "excluded_field_keys": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
